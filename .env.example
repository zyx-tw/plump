# /opt/plump/.env on the host, or .env.local in development.
PLUMP_VERSION=latest
# Where the web port binds; put a reverse proxy with TLS in front.
PLUMP_BIND=127.0.0.1:3000

# Traces and logs to Sensorium (OTLP/JSON); leave the endpoint empty to send nothing.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=plump
